{
  "name": "appjs-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/jobs/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/telemetry.js dist/index.js",
    "worker": "node --import ./dist/telemetry.js dist/jobs/worker.js",
    "migrate": "node dist/db/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "auth:generate": "npx @better-auth/cli generate --config src/auth.ts --output src/db/auth-schema.ts -y",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "up": "docker compose up -d --build",
    "down": "docker compose -f docker-compose.yml -f docker-compose.scale.yml --profile monitoring --profile dev down",
    "logs": "docker compose logs -f api worker",
    "up:monitoring": "docker compose --profile monitoring up -d --build",
    "up:scale": "docker compose -f docker-compose.yml -f docker-compose.scale.yml --profile monitoring up -d --build",
    "load:http": "docker compose --profile load run --rm k6 run /scripts/http.js",
    "load:ws": "docker compose --profile load run --rm k6 run /scripts/ws.js",
    "load:http:scale": "docker compose -f docker-compose.yml -f docker-compose.scale.yml --profile load run --rm -e BASE=http://lb:8080 k6 run /scripts/http.js",
    "load:ws:scale": "docker compose -f docker-compose.yml -f docker-compose.scale.yml --profile load run --rm -e BASE=http://lb:8080 k6 run /scripts/ws.js"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.16",
    "@hono/node-server": "^1.19.18",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.9.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-ioredis": "^0.72.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "better-auth": "^1.7.16",
    "bullmq": "^6.5.4",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "postgres": "^4.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
