{
  "name": "appjs-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/jobs/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "worker": "node dist/jobs/worker.js",
    "migrate": "node dist/db/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "auth:generate": "npx @better-auth/cli generate --config src/auth.ts --output src/db/auth-schema.ts -y",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f api worker"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.16",
    "@hono/node-server": "^1.19.18",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.16",
    "bullmq": "^6.5.4",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
