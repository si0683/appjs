# Балансировщик копий API (docker-compose.scale.yml). HTTPS в проде — замените
# :8080 на домен (api.example.com), Caddy сам выпустит сертификат Let's Encrypt.
:8080 {
	reverse_proxy {
		dynamic a {
			name api
			port 8080
			refresh 5s
		}
		lb_policy least_conn
		health_uri /ready
		health_interval 5s
		health_timeout 2s
	}
}
