# Скопируйте в .env. В Docker Compose значения берутся из docker-compose.yml.
NODE_ENV=development
PORT=8080
# Публичный адрес сервера (для ссылок в письмах и на страницах)
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://app:app@localhost:5433/app
REDIS_URL=redis://localhost:6380
# Секрет сессий: openssl rand -base64 32 (в проде — обязательно свой)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-32-chars
# Откуда принимать вход: схема приложения (app.json → scheme) и адреса веба
TRUSTED_ORIGINS=appjs://,http://localhost:8081
# Биржевой поток: binance | off
MARKET_FEED=binance
MARKET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,TONUSDT,DOGEUSDT,ADAUSDT
# Лимит запросов с одного IP в минуту
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info
