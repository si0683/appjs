# Скопируйте в .env. В Docker Compose значения берутся из docker-compose.yml.
NODE_ENV=development
PORT=8080
# Публичный адрес сервера (для ссылок в письмах и на страницах)
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://app:app@localhost:5433/app
REDIS_URL=redis://localhost:6380
# Секрет сессий: openssl rand -base64 32 (в проде — обязательно свой)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-32-chars
# Откуда принимать вход: схема приложения (app.json → scheme) и адреса веба
TRUSTED_ORIGINS=appjs://,http://localhost:8081
# Биржевой поток: binance | off
MARKET_FEED=binance
MARKET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,TONUSDT,DOGEUSDT,ADAUSDT
# Лимит запросов с одного IP в минуту
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info

# ---- Способы входа (подробно: AUTH.md). Пустые ключи — кнопка не показывается.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: Services ID, секрет (JWT из ключа .p8) и bundle id приложения (для входа в iOS)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# Вход по телефону: off | console (код в логах, для разработки) | smsru | twilio
SMS_PROVIDER=console
SMS_SENDER=
SMSRU_API_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Нагрузка и наблюдаемость (подробно: LOAD.md)
# true — сервер за своим прокси/балансировщиком (IP клиента из X-Forwarded-For)
TRUST_PROXY=false
# Пул соединений с базой на копию; через PgBouncer — DB_PREPARE=false
DB_POOL_MAX=20
DB_PREPARE=true
# /metrics для Prometheus: пусто — открыт (закройте снаружи), иначе Bearer-токен
METRICS_TOKEN=
# Трассы OpenTelemetry: адрес OTLP, например http://jaeger:4318. Пусто — выключены
OTEL_EXPORTER_OTLP_ENDPOINT=
